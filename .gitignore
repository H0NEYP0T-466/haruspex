# ==============================================================================
# HARUSPEX Git Ignore Rules
# ==============================================================================

# --- Dataset Files (DO NOT COMMIT DATASETS) ---
backend/dataset/
dataset/
*.npz
*.tar.gz
*.zip
*.7z
deepLearning/phase1/models/
deepLearning/phase2/models/
deepLearning/*/models/
*.pth
*.pt

# --- Model & Output Artifacts ---
outputs/models/
outputs/*.json
outputs/*.txt
*.pkl
*.joblib
*.ubj
*.model

# --- Python Virtual Environments ---
backend/.venv/
backend/venv/
.venv/
venv/
ENV/
env/

# --- Environment & Secret Files ---
backend/.env
.env
.env.local
*.env

# --- Byte-compiled / Python Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.nox/
.tox/

# --- Build & Distribution ---
dist/
dist-ssr/
build/
*.egg-info/
.eggs/

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.oxlintrc.json.log

# --- IDEs & OS Files ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
